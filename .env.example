DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Necessária para `prisma migrate deploy`/`migrate dev` quando DATABASE_URL
# é uma connection string "pooled" (ex.: hostname com "-pooler" no Neon).
# O advisory lock que o Prisma Migrate usa não é confiável através de um
# pooler em modo transaction. Use a variante DIRETA (sem "-pooler") da
# mesma connection string. Em dev local sem pooler, pode deixar sem definir
# — cai automaticamente para DATABASE_URL.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Opcional: só necessário se for usar /api/admin/seed para resetar os dados
# de demonstração sem acesso local ao banco (ver README). Escolha qualquer
# valor secreto — é a "senha" para chamar essa rota.
SEED_TOKEN=""

# Opcional: em produção, /api/admin/seed fica desligada (resetar apaga o
# histórico). "true" religa a rota — use só para recomeçar a demo do zero e
# remova em seguida.
ALLOW_DEMO_RESET=""
