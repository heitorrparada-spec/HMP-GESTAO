// HMP OS — schema conceitual v0.1 (protótipo)
// Reflete docs/hmp-os/conceptual-architecture-v0.1.md.
// Simplificações deliberadas para o protótipo (ver README > Notas de escopo):
// - Role é um enum em Person, não uma entidade própria.
// - Decision liga direto a Feature/Product (FK simples), não uma tabela de vínculo N-N genérica.
// - AcceptanceCriteria guarda o status atual; ValidationRecord guarda o resultado por tentativa.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum RoleName {
  PRODUCT
  ARCHITECTURE
  ENGINEERING
}

enum ProductStatus {
  DISCOVERY
  DEVELOPMENT
  PAUSED
  DISCONTINUED
}

enum ReleaseStatus {
  PLANNED
  IN_PROGRESS
  SHIPPED
}

enum FeatureStatus {
  BACKLOG
  DISCOVERY
  SPECIFICATION
  ARCHITECTURE
  DEVELOPMENT
  REVIEW
  VALIDATION
  DONE
}

enum Priority {
  P0
  P1
  P2
  P3
}

enum RequirementStatus {
  PROPOSED
  APPROVED
  IMPLEMENTED
  TESTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum ArtifactType {
  DOCUMENT
  C4
  CLASS_DIAGRAM
  SEQUENCE_DIAGRAM
  RESEARCH
  REFERENCE
  SPECIFICATION
}

enum CriteriaStatus {
  PENDING
  PASSED
  FAILED
}

enum ValidationResult {
  PENDING
  APPROVED
  REJECTED
}

// V0.3-A: mudar o mérito de uma decisão travada = nova decisão que substitui (SUPERSEDED) ou revogação (REVOKED).
enum DecisionStatus {
  ACTIVE
  SUPERSEDED
  REVOKED
}

// ---------- Núcleo organizacional ----------

model Company {
  id        String    @id @default(cuid())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Person {
  id     String   @id @default(cuid())
  name   String
  email  String   @unique
  role   RoleName
  active Boolean  @default(true)

  ownedFeatures       Feature[] @relation("FeatureOwner")
  architectedFeatures Feature[] @relation("FeatureArchitect")
  ledFeatures         Feature[] @relation("FeatureTechLead")

  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreatedBy")
  reviewedTasks Task[] @relation("TaskReviewer")

  authoredDecisions      Decision[]            @relation("DecisionAuthor")
  decisionParticipations DecisionParticipant[]
  meetingParticipations  MeetingParticipant[]
  authoredArtifacts      Artifact[]            @relation("ArtifactAuthor")
  validationsPerformed   ValidationRecord[]    @relation("ValidationValidatedBy")

  archivedTasks        Task[]               @relation("TaskArchivedBy")
  archivedRequirements Requirement[]        @relation("RequirementArchivedBy")
  archivedCriteria     AcceptanceCriteria[] @relation("CriteriaArchivedBy")
  revokedDecisions     Decision[]           @relation("DecisionRevokedBy")

  createdAt DateTime @default(now())
}

model Product {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  name        String
  description String
  status      ProductStatus @default(DISCOVERY)

  features  Feature[]
  releases  Release[]
  decisions Decision[] @relation("DecisionProduct")

  createdAt DateTime @default(now())
}

model Release {
  id         String        @id @default(cuid())
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  name       String
  targetDate DateTime?
  status     ReleaseStatus @default(PLANNED)
  features   Feature[]

  createdAt DateTime @default(now())
}

// ---------- Feature: entidade central ----------

model Feature {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  releaseId String?
  release   Release? @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  title             String
  context           String?
  problem           String?
  userNeed          String?
  objective         String?
  functionalFlow    String?
  architectureNotes String?
  priority          Priority?
  status            FeatureStatus @default(BACKLOG)

  ownerId     String?
  owner       Person? @relation("FeatureOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  architectId String?
  architect   Person? @relation("FeatureArchitect", fields: [architectId], references: [id], onDelete: Restrict)
  techLeadId  String?
  techLead    Person? @relation("FeatureTechLead", fields: [techLeadId], references: [id], onDelete: Restrict)

  requirements       Requirement[]
  tasks              Task[]
  artifacts          Artifact[]
  acceptanceCriteria AcceptanceCriteria[]
  validationRecords  ValidationRecord[]
  decisions          Decision[]           @relation("DecisionFeature")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Requirement {
  id          String            @id @default(cuid())
  featureId   String
  feature     Feature           @relation(fields: [featureId], references: [id])
  description String
  priority    Priority          @default(P2)
  status      RequirementStatus @default(PROPOSED)
  source      String?

  archivedAt    DateTime?
  archivedById  String?
  archivedBy    Person?   @relation("RequirementArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  archiveReason String?

  createdAt DateTime @default(now())

  @@index([featureId, archivedAt])
}

// ---------- Task: unidade de execução ----------

model Task {
  id           String   @id @default(cuid())
  featureId    String?
  feature      Feature? @relation(fields: [featureId], references: [id], onDelete: Restrict)
  parentTaskId String?
  parentTask   Task?    @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Restrict)
  subtasks     Task[]   @relation("TaskSubtasks")

  title         String
  description   String?
  status        TaskStatus @default(TODO)
  priority      Priority   @default(P2)
  dueDate       DateTime?
  blockedReason String?

  assigneeId  String?
  assignee    Person? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdById String?
  createdBy   Person? @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewerId  String?
  reviewer    Person? @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  decisionId String?
  decision   Decision? @relation("DecisionGeneratedTasks", fields: [decisionId], references: [id], onDelete: Restrict)
  meetingId  String?
  meeting    Meeting?  @relation("MeetingFollowUps", fields: [meetingId], references: [id], onDelete: Restrict)

  dependsOn TaskDependency[] @relation("DependentTask")
  blocks    TaskDependency[] @relation("DependencyTask")

  // V0.3-A: nada é apagado — "excluir" virou arquivar, com motivo.
  archivedAt    DateTime?
  archivedById  String?
  archivedBy    Person?   @relation("TaskArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([featureId, archivedAt])
}

model TaskDependency {
  id            String @id @default(cuid())
  taskId        String
  task          Task   @relation("DependentTask", fields: [taskId], references: [id])
  dependsOnId   String
  dependsOnTask Task   @relation("DependencyTask", fields: [dependsOnId], references: [id])

  @@unique([taskId, dependsOnId])
}

// ---------- Conhecimento & decisão ----------

model Meeting {
  id     String   @id @default(cuid())
  title  String
  date   DateTime
  agenda String?
  notes  String?

  participants  MeetingParticipant[]
  decisions     Decision[]           @relation("DecisionMeeting")
  followUpTasks Task[]               @relation("MeetingFollowUps")
  artifacts     Artifact[]           @relation("ArtifactMeeting")

  createdAt DateTime @default(now())
}

model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id])
  personId  String
  person    Person  @relation(fields: [personId], references: [id])

  @@unique([meetingId, personId])
}

model Decision {
  id           String  @id @default(cuid())
  title        String
  context      String?
  decision     String
  reason       String?
  alternatives String?

  authorId  String?
  author    Person?  @relation("DecisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  decidedAt DateTime @default(now())

  meetingId String?
  meeting   Meeting? @relation("DecisionMeeting", fields: [meetingId], references: [id], onDelete: Restrict)

  featureId String?
  feature   Feature? @relation("DecisionFeature", fields: [featureId], references: [id], onDelete: Restrict)
  productId String?
  product   Product? @relation("DecisionProduct", fields: [productId], references: [id], onDelete: Restrict)

  participants   DecisionParticipant[]
  generatedTasks Task[]                @relation("DecisionGeneratedTasks")
  artifacts      Artifact[]            @relation("ArtifactDecision")

  // V0.3-A: "travada" é derivado (tem task gerada ou passou a janela de correção desde createdAt).
  status       DecisionStatus @default(ACTIVE)
  supersedesId String?        @unique
  supersedes   Decision?      @relation("DecisionSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy Decision?      @relation("DecisionSupersession")
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    Person?        @relation("DecisionRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  revokeReason String?

  createdAt DateTime @default(now())
}

model DecisionParticipant {
  id         String   @id @default(cuid())
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id])
  personId   String
  person     Person   @relation(fields: [personId], references: [id])

  @@unique([decisionId, personId])
}

// ---------- Artefatos & documentação ----------

model Artifact {
  id          String       @id @default(cuid())
  title       String
  type        ArtifactType
  description String?
  url         String?
  version     String?      @default("v1")

  featureId String?
  feature   Feature? @relation(fields: [featureId], references: [id], onDelete: Restrict)

  meetingId String?
  meeting   Meeting? @relation("ArtifactMeeting", fields: [meetingId], references: [id], onDelete: Restrict)

  decisionId String?
  decision   Decision? @relation("ArtifactDecision", fields: [decisionId], references: [id], onDelete: Restrict)

  authorId String?
  author   Person? @relation("ArtifactAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
}

// ---------- Validação ----------

model AcceptanceCriteria {
  id          String         @id @default(cuid())
  featureId   String
  feature     Feature        @relation(fields: [featureId], references: [id])
  description String
  status      CriteriaStatus @default(PENDING)

  archivedAt    DateTime?
  archivedById  String?
  archivedBy    Person?   @relation("CriteriaArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  archiveReason String?

  createdAt DateTime @default(now())

  @@index([featureId, archivedAt])
}

model ValidationRecord {
  id               String           @id @default(cuid())
  featureId        String
  feature          Feature          @relation(fields: [featureId], references: [id])
  attemptNumber    Int
  overallResult    ValidationResult @default(PENDING)
  notes            String?
  issuesFound      String?
  // [{ id, description, status }] desta tentativa — AcceptanceCriteria.status só guarda o estado atual.
  criteriaSnapshot Json?

  validatedById String?
  validatedBy   Person?   @relation("ValidationValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  validatedAt   DateTime?

  // V0.3-A: o que estava em vigor nesta tentativa ("o que foi aprovado"), mesmo que mude depois.
  requestedResult      ValidationResult?
  validatedByName      String?
  requirementsSnapshot Json?
  tasksSnapshot        Json?
  featureSnapshot      Json?

  createdAt DateTime @default(now())
}

// ---------- Rastreabilidade ----------

// Somente-inserção (trigger no banco proíbe UPDATE/DELETE). schemaVersion 1 = legado (só texto);
// 2 = estruturado: linhas de mudança (ActivityChange), snapshot, contexto e escopos por agregado.
model ActivityLog {
  id          String   @id @default(cuid())
  seq         BigInt   @unique @default(autoincrement())
  entityType  String
  entityId    String
  eventType   String
  actorId     String?
  actorName   String?
  description String
  createdAt   DateTime @default(now())

  schemaVersion Int     @default(1)
  source        String  @default("app")
  correlationId String?
  entityLabel   String?
  reason        String?
  context       Json?
  snapshot      Json?
  featureId     String?
  decisionId    String?
  meetingId     String?
  productId     String?

  changes ActivityChange[]

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([featureId, seq])
  @@index([decisionId, seq])
  @@index([meetingId, seq])
  @@index([productId, seq])
  @@index([actorId, seq])
  @@index([correlationId])
}

model ActivityChange {
  id        String      @id @default(cuid())
  eventId   String
  event     ActivityLog @relation(fields: [eventId], references: [id], onDelete: Restrict)
  field     String
  fromValue Json?
  toValue   Json?
  fromLabel String?
  toLabel   String?

  @@index([eventId])
  @@index([field])
}
